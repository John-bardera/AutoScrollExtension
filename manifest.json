{
  "manifest_version": 3,
  "name": "Auto Scroll",
  "version": "0.1.1",
  "description": "長文読書のための自動スクロール拡張機能。Alt+S で ON/OFF、速度調整はポップアップまたは↑↓キー。",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Scroll"
  },
  "commands": {
    "toggle-scroll": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "自動スクロールの ON/OFF 切替"
    }
  }
}
